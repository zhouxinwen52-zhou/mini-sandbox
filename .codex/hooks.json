{
  "description": "Project-local MiniSandbox production PreToolUse rewrite.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/dist/codex/pre-tool-use.js\"",
            "timeout": 10,
            "statusMessage": "Routing Bash through MiniSandbox"
          }
        ]
      }
    ]
  }
}
